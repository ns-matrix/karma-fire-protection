# =============================================
# KARMA FIRE PROTECTION LLP — ENVIRONMENT
# Copy this file to ".env" and fill in values.
# NEVER commit the real .env file.
# =============================================

# --- Server ---
PORT=3000
NODE_ENV=production

# Comma-separated list of allowed browser origins for CORS.
# Leave empty to allow same-origin requests only.
# Example: https://www.karmafireprotection.com,https://karmafireprotection.com
ALLOWED_ORIGINS=

# --- Telegram ---
# Create a bot with @BotFather, then paste the token here.
TELEGRAM_BOT_TOKEN=9239303763:AAHsC23U6gkuInGCEg60h-S9tbavOpPosGQ

# Chat ID that receives lead notifications.
# Send the bot a message first, then get your ID from @userinfobot
TELEGRAM_CHAT_ID=

# Comma-separated Telegram user IDs allowed to use admin commands.
# Example: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# --- Database ---
# Path to the SQLite file (created automatically). Default: ./data/leads.db
DB_PATH=
